items.LumenGolemBunnyEars.name = "Golem Bunny Ears"
items.LumenGolemBunnyEars.description = "Right-Click to place these on the Lumen Golem.\n\n\"It's amazing what you can do with a few slabs of wood and a coat of paint! Here, you try!\" - A transcript of Avatar Estea lecturing a class of Ancients"
items.LumenGolemPointyEars.name = "Golem Pointy Ears"
items.LumenGolemPointyEars.description = "Right-Click to place these on the Lumen Golem.\n\n\"Won't these make them look more, you know, personable?\" - A transcript of Avatar Estea lecturing a class of Ancients"
items.LumenGolemMonocle.name = "Golem Monocle"
items.LumenGolemMonocle.description = "Right-Click to place these on the Lumen Golem.\n\n\"It'll definitely give them a classy flair!\" - A transcript of Avatar Estea lecturing a class of Ancients"

items.LumenGolemItem.name = "Lumen Golem"
items.LumenGolemItem.description = "Right-Click to deploy the Lumen Golem.\nPress F while facing the Lumen Golem to modify its behavior.\n\n\"It is exceptionally endearing how these little creatures use my creativity for their own little needs! How adorable!\" - The writings of the Lost Avatar Estea"
items.LumenVectorSelector.name = "Vector Selector"
items.LumenVectorSelector.description = "Left-Click to save a vector to be recorded next you modify a golem.\nRight-Click to clear all saved vectors.\n\n\"Of course, me, being an Avatar, must share with them this little secret to unlocking their creativity!\" - The writings of the Lost Avatar Estea"